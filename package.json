{
  "name": "crypto-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "clean": "turbo run clean",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "frontend:dev": "turbo dev --filter=@crypto-platform/frontend",
    "frontend:build": "turbo build --filter=@crypto-platform/frontend",
    "start:dev": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1 -Env development",
    "start:prod": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1 -Env production",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1"
  },
  "devDependencies": {
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "tsx": "4.19.3",
    "vitest": "3.1.1",
    "@types/node": "22.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "uWebSockets.js"
    ]
  }
}
